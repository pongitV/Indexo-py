/* Flexoki Dark Theme (High Legibility & Comfort) */
QMainWindow, QDialog {
    background-color: #100F0F;
    color: #CECDC3;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 15px;
}

QWidget {
    color: #CECDC3;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 15px;
}

QWidget#settings_panel, QWidget#settings_container {
    background-color: #100F0F;
    color: #CECDC3;
}

QScrollArea#settings_scroll {
    background-color: transparent;
    border: none;
}

QLabel {
    background: transparent;
    color: #CECDC3;
    font-size: 15px;
}

QTreeWidget, QListWidget, QTableWidget, QTextEdit {
    background-color: #1C1B1A;
    border: 1px solid #282726;
    border-radius: 6px;
    color: #CECDC3;
    font-size: 15px;
}

QTreeWidget::item, QListWidget::item, QTableWidget::item {
    padding: 6px 8px;
    font-size: 14px;
}

QTreeWidget::item:hover, QListWidget::item:hover, QTableWidget::item:hover {
    background-color: #282726;
}

QTreeWidget::item:selected, QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #343331;
    color: #FFFCF0;
}

QPushButton {
    background-color: #282726;
    color: #CECDC3;
    border: 1px solid #343331;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #343331;
}

QPushButton:pressed {
    background-color: #CECDC3;
    color: #100F0F;
}

QPushButton:disabled {
    background-color: #1C1B1A;
    color: #6F6E69;
    border-color: #282726;
}

QLineEdit, QComboBox {
    background-color: #1C1B1A;
    border: 1px solid #282726;
    border-radius: 4px;
    padding: 8px 12px;
    color: #CECDC3;
    font-size: 14px;
}

QLineEdit:focus, QComboBox:focus {
    border: 2px solid #205EA6;
}

QHeaderView::section {
    background-color: #282726;
    color: #CECDC3;
    padding: 6px 10px;
    border: 1px solid #343331;
    font-weight: 600;
    font-size: 14px;
}

QProgressBar {
    border: 1px solid #282726;
    border-radius: 3px;
    background-color: #1C1B1A;
    text-align: center;
    font-size: 13px;
}

QProgressBar::chunk {
    background-color: #205EA6;
    border-radius: 2px;
}

QScrollBar:vertical {
    border: none;
    background: #100F0F;
    width: 10px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background: #343331;
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #4E4C48;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: #100F0F;
    height: 10px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:horizontal {
    background: #343331;
    min-width: 30px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #4E4C48;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* Card Panels & Contextual Containers */
QFrame#card_top, QFrame#card_options, QFrame#card_summary, QFrame#privacy_card, QFrame#prof_card, QFrame#comparison_col {
    background-color: #1C1B1A;
    border: 1px solid #282726;
    border-radius: 6px;
}

QLabel#lbl_subtext {
    color: #878580;
}

QLabel#lbl_before {
    color: #4385BE;
}

QLabel#lbl_after {
    color: #879A39;
}
